# No API keys required — all ML runs locally

# ── Streamlit Server ──────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ── Veridex Configuration ─────────────────────────
VERIDEX_MAX_SOURCES=10
VERIDEX_RATE_LIMIT_DELAY=1.0
VERIDEX_DB_PATH=data/research_history.db

# ── Search Provider ───────────────────────────────────
# Options: auto | ddg | tavily  (auto picks Tavily when TAVILY_API_KEY is set)
VERIDEX_SEARCH_PROVIDER=auto
# Required when using Tavily provider (get your key at https://app.tavily.com)
# TAVILY_API_KEY=tvly-YOUR_API_KEY

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
