# No API keys required — all ML runs locally

# ── Streamlit Server ──────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ── ResearchBot Configuration ─────────────────────────
RESEARCHBOT_MAX_SOURCES=10
RESEARCHBOT_RATE_LIMIT_DELAY=1.0
RESEARCHBOT_DB_PATH=data/research_history.db

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
